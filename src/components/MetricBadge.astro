---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<p class="metric">
  <span class="metric__value">{value}</span>
  <span class="metric__label">{label}</span>
</p>

<style>
  .metric {
    display: grid;
    gap: 0.3rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--r-media);
    background: var(--surface);
    max-width: 44rem;
  }
  .metric__value {
    font-size: clamp(1.4rem, 1.15rem + 1vw, 1.85rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .metric__label {
    color: var(--muted);
    line-height: 1.5;
  }
</style>
