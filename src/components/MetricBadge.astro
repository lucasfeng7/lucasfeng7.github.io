---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<p class="metric">
  <span class="metric__value">{value}</span>
  <span class="metric__label">{label}</span>
</p>

<style>
  .metric {
    display: grid;
    gap: 0.25rem;
    padding-left: 1.1rem;
    border-left: 3px solid var(--layout-blue);
    max-width: 40rem;
  }
  .metric__value {
    font-size: var(--step-2);
    font-stretch: 112%;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .metric__label {
    color: var(--graphite);
    line-height: 1.5;
  }
</style>
