---
interface Props {
  caption?: string;
  columns: string[];
  rows: (string | number)[][];
}
const { caption, columns, rows } = Astro.props;
---

<div class="spec">
  <div class="scroll-x">
    <table>
      {caption && <caption>{caption}</caption>}
      <thead>
        <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              {r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .spec {
    margin-block: 1.75rem;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
  }
  caption {
    text-align: left;
    font-size: 0.85rem;
    color: var(--graphite);
    margin-bottom: 0.5rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--hairline);
    white-space: nowrap;
  }
  thead th {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--graphite);
    border-bottom: 1.5px solid var(--ink);
  }
  tbody th {
    font-weight: 550;
  }
  td {
    font-variant-numeric: tabular-nums;
  }
  tbody tr:last-child :is(th, td) {
    border-bottom: none;
  }
</style>
