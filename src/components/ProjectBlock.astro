---
import { Image } from 'astro:assets';
import { getImage } from '../lib/images';

interface Props {
  href: string;
  title: string;
  metric: string;
  metricLabel: string;
  tagline: string;
  image: string;
  imageAlt: string;
  tags?: string[];
  meta?: string;
  eager?: boolean;
}
const { href, title, metric, metricLabel, tagline, image, imageAlt, tags = [], meta, eager = false } = Astro.props;
---

<article class="project">
  <a href={href} class="project__media" tabindex="-1" aria-hidden="true">
    <Image
      src={getImage(image)}
      alt={imageAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 900px) 560px, 100vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </a>
  <div class="project__body">
    {meta && <p class="project__meta">{meta}</p>}
    <h3 class="project__title"><a href={href}>{title}</a></h3>
    <p class="project__tagline">{tagline}</p>
    <dl class="project__result">
      <dt>Result</dt>
      <dd><strong>{metric}</strong> {metricLabel}</dd>
    </dl>
    {tags.length > 0 && <p class="project__tags">{tags.join(', ')}</p>}
    <a class="link project__cta" href={href}>Read the case study<span class="visually-hidden">: {title}</span></a>
  </div>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .project__media {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--paper);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }
  .project__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(0.5rem, 2vw, 1.25rem);
  }
  .project__meta {
    color: var(--graphite);
    font-size: var(--step--1);
  }
  .project__title {
    margin-top: 0.35rem;
    font-size: var(--step-3);
  }
  .project__title a:hover {
    color: var(--layout-blue);
  }
  .project__tagline {
    margin-top: 0.9rem;
    max-width: 52ch;
  }
  .project__result {
    margin-top: 1.25rem;
    padding-left: 1rem;
    border-left: 2px solid var(--layout-blue);
    max-width: 52ch;
  }
  .project__result dt {
    font-size: var(--step--1);
    color: var(--graphite);
  }
  .project__result dd {
    margin: 0.1rem 0 0;
    line-height: 1.45;
  }
  .project__result strong {
    font-weight: 650;
  }
  .project__tags {
    margin-top: 1.1rem;
    color: var(--graphite);
    font-size: var(--step--1);
  }
  .project__cta {
    display: inline-block;
    margin-top: 1.25rem;
  }

  @media (max-width: 820px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
