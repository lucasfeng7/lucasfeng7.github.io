---
import { Image } from 'astro:assets';
import { getImage } from '../lib/images';

interface Props {
  href: string;
  title: string;
  metric: string;
  tagline: string;
  image: string;
  imageAlt: string;
  imagePosition?: string;
  tags?: string[];
  eager?: boolean;
}
const { href, title, metric, tagline, image, imageAlt, imagePosition = '50% 50%', tags = [], eager = false } = Astro.props;
---

<article class="card">
  <div class="card__media">
    <Image
      src={getImage(image)}
      alt={imageAlt}
      widths={[480, 720, 1080]}
      sizes="(min-width: 900px) 560px, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      style={`object-position:${imagePosition}`}
    />
  </div>
  <div class="card__body">
    {tags.length > 0 && (
      <ul class="card__tags" aria-label="Topics">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
    )}
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    <p class="card__tagline">{tagline}</p>
    <p class="card__result"><span>Result:</span> {metric}</p>
    <span class="card__cta" aria-hidden="true">Read the case study</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .card__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-media);
    overflow: hidden;
    background: var(--surface);
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }
  .card:hover .card__media :global(img) {
    transform: scale(1.035);
  }
  .card__body {
    padding-top: 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
  }
  .card__tags li {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    background: var(--surface);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }
  .card__title {
    font-size: var(--text-h3);
    line-height: 1.2;
  }
  /* the title link covers the whole card */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--r-media);
  }
  .card__title a:focus-visible {
    outline: none;
  }
  .card__title a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .card:hover .card__title {
    color: var(--accent);
  }
  .card__tagline {
    margin-top: 0.6rem;
    color: var(--muted);
  }
  .card__result {
    margin-top: 1rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .card__result span {
    color: var(--muted);
    font-weight: 500;
  }
  .card__cta {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }
  .card:hover .card__cta {
    text-decoration-thickness: 2.5px;
  }
</style>
