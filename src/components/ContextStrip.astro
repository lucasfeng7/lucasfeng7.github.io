---
interface Props {
  role: string;
  org: string;
  dateRange: string;
  team?: string[];
  tools?: string[];
  status?: string;
}
const { role, org, dateRange, team = [], tools = [], status } = Astro.props;

const items: { label: string; value: string }[] = [
  { label: 'My role', value: role },
  { label: 'Lab', value: org },
  { label: 'Year', value: dateRange },
];
if (team.length) items.push({ label: 'Team', value: team.join(', ') });
if (tools.length) items.push({ label: 'Tools', value: tools.join(', ') });
if (status) items.push({ label: 'Status', value: status });
---

<dl class="meta">
  {
    items.map((it) => (
      <div>
        <dt>{it.label}</dt>
        <dd>{it.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem 2.5rem;
    margin-block: 2.5rem 3rem;
    padding-block: 2rem;
    border-block: 1px solid var(--line);
  }
  dt {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 0.3rem 0 0;
    line-height: 1.5;
  }
</style>
