---
import { Image } from 'astro:assets';
import { getImage } from '../lib/images';

interface Props {
  href: string;
  title: string;
  metric: string;
  tagline: string;
  image: string;
  imageAlt: string;
  tags?: string[];
}
const { href, title, metric, tagline, image, imageAlt, tags = [] } = Astro.props;
---

<a class="card" href={href}>
  <div class="card__media">
    <Image src={getImage(image)} alt={imageAlt} widths={[400, 640, 900]} sizes="(min-width: 780px) 540px, 100vw" />
  </div>
  <div class="card__body">
    <div class="card__tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
    <h3 class="card__title">{title}</h3>
    <p class="card__metric">{metric}</p>
    <p class="card__tagline">{tagline}</p>
    <span class="card__cta">View project →</span>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .card__media {
    aspect-ratio: 16 / 10;
    background: #fff;
    border-bottom: 1px solid var(--border);
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__body {
    padding: 1.25rem 1.4rem 1.5rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
  .card__title {
    font-size: 1.2rem;
  }
  .card__metric {
    font-weight: 550;
    color: var(--text);
  }
  .card__tagline {
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .card__cta {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    font-weight: 550;
    color: var(--accent);
  }
</style>
