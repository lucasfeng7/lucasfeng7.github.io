---
import { Image } from 'astro:assets';
import headshot from '../assets/site/headshot.jpg';
import Icon from './Icon.astro';
import { site } from '../lib/site';
---

<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__photo">
      <Image
        src={headshot}
        alt="Portrait of Lucas Feng"
        widths={[400, 640, 960]}
        sizes="(min-width: 860px) 440px, 90vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="hero__text">
      <h1>{site.heroGreeting}</h1>
      <p class="hero__bio">{site.heroBio}</p>
      <div class="hero__actions">
        <a class="btn" href={site.linkedin} target="_blank" rel="me noopener">
          <Icon name="linkedin" /> LinkedIn
        </a>
        <a class="btn btn--secondary" href="/resume">
          <Icon name="file" /> Résumé
        </a>
      </div>
      <p class="hero__email">
        Or email me at <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 4vw, 3rem) 0;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(240px, 360px) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: center;
  }
  .hero__photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-media);
    overflow: hidden;
    background: var(--surface);
  }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: settle 1.4s var(--ease-out) both;
  }
  .hero__text h1 {
    font-size: var(--text-h1);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .hero__bio {
    margin-top: 1.5rem;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.5;
    color: var(--muted);
    max-width: 34ch;
  }
  .hero__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__email {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  @keyframes settle {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }

  @media (max-width: 760px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__photo {
      aspect-ratio: 4 / 3;
    }
    .hero__photo :global(img) {
      object-position: 50% 22%;
    }
  }
</style>
