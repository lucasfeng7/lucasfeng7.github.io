---
import { site, nav } from '../lib/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrent(href: string) {
  if (href.includes('#')) return false; // anchor link, not a distinct page
  const target = href.replace(/\/$/, '') || '/';
  return path === target;
}
---

<header class="nav">
  <div class="wrap nav__inner">
    <nav class="nav__links" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/" class="nav__brand">{site.brand}</a>

    <ul class="nav__social" aria-label="Social">
      <li>
        <a href={site.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <rect x="0.5" y="0.5" width="23" height="23" rx="5" fill="none" stroke="currentColor" />
            <path
              fill="currentColor"
              d="M7.2 9.5H4.6V18.7H7.2V9.5ZM5.9 8.3C6.8 8.3 7.4 7.7 7.4 6.9C7.4 6.1 6.8 5.5 5.9 5.5C5 5.5 4.4 6.1 4.4 6.9C4.4 7.7 5 8.3 5.9 8.3ZM19.5 13.4C19.5 10.8 18.1 9.3 15.9 9.3C14.4 9.3 13.5 10.1 13.1 10.8H13V9.5H10.5V18.7H13.1V13.9C13.1 12.6 13.6 11.6 14.8 11.6C15.9 11.6 16.3 12.4 16.3 13.9V18.7H19V13.4H19.5Z"
            />
          </svg>
        </a>
      </li>
      <li>
        <a href={`mailto:${site.email}`} aria-label="Email">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <rect x="0.5" y="0.5" width="23" height="23" rx="5" fill="none" stroke="currentColor" />
            <path
              fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"
              d="M5.5 7.5h13a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1Z M5 8l7 5.2L19 8"
            />
          </svg>
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: var(--nav-h);
  }
  .nav__links ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    list-style: none;
    padding: 0;
    font-size: 0.94rem;
  }
  .nav__links a {
    color: var(--text);
    padding-block: 0.4rem;
    font-weight: 500;
  }
  .nav__links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }
  .nav__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-align: center;
    white-space: nowrap;
  }
  .nav__social {
    display: flex;
    justify-content: flex-end;
    gap: 0.9rem;
    list-style: none;
    padding: 0;
  }
  .nav__social a {
    color: var(--text);
    display: flex;
  }
  .nav__social a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .nav__inner {
      grid-template-columns: auto auto;
      grid-template-areas: 'brand social' 'links links';
      row-gap: 0.5rem;
      padding-block: 0.75rem;
    }
    .nav__brand { grid-area: brand; text-align: left; font-size: 0.95rem; }
    .nav__social { grid-area: social; }
    .nav__links { grid-area: links; }
    .nav__links ul { gap: 1.1rem; }
  }
</style>
