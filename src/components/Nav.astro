---
import { site, nav } from '../lib/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrent(href: string) {
  if (href.includes('#')) return false; // anchor link, not a distinct page
  const target = href.replace(/\/$/, '') || '/';
  return path === target;
}
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="nav__brand">{site.name}</a>

    <nav aria-label="Primary">
      <ul class="nav__links">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class={item.href === '/#about' ? 'nav__optional' : undefined} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav__cta"><a href="/#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--nav-h);
  }
  .nav__brand {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 0.75rem);
    list-style: none;
    padding: 0;
    font-size: 0.95rem;
  }
  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: 0.7rem;
    border-radius: var(--r-control);
    color: var(--muted);
    font-weight: 500;
    transition: color 0.2s, background-color 0.2s;
  }
  .nav__links a:hover {
    color: var(--ink);
    background: var(--surface);
  }
  .nav__links a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
  .nav__cta a {
    color: var(--ink);
    border: 1.5px solid var(--line);
    font-weight: 600;
  }
  @media (max-width: 520px) {
    .nav__brand { font-size: 1rem; }
    .nav__links { font-size: 0.875rem; gap: 0; }
    .nav__links a { padding-inline: 0.45rem; }
    .nav__optional { display: none !important; }
  }
</style>
