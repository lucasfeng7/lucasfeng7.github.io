---
import { Image } from 'astro:assets';
import { getImage } from '../lib/images';

interface Item {
  src: string;
  alt: string;
  label?: string;
}
interface Props {
  items: Item[];
  caption?: string;
  panel?: boolean;
  /** min column width before wrapping */
  min?: string;
}

const { items, caption, panel = false, min = '150px' } = Astro.props;
---

<figure class:list={['row', { 'row--panel': panel }]}>
  <div class="row__grid" style={`--min:${min}`}>
    {
      items.map((it) => (
        <div class="row__cell">
          <Image src={getImage(it.src)} alt={it.alt} widths={[240, 480, 720]} sizes="240px" loading="lazy" />
          {it.label && <span class="row__label">{it.label}</span>}
        </div>
      ))
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .row {
    margin-block: 1.75rem;
  }
  .row__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--min), 1fr));
    gap: 0.75rem;
  }
  .row__cell {
    display: grid;
    gap: 0.4rem;
  }
  .row__cell :global(img) {
    width: 100%;
    border-radius: 0;
    border: 1px solid var(--hairline);
  }
  .row--panel .row__cell :global(img) {
    background: #fff;
    padding: 0.4rem;
  }
  .row__label {
    font-size: 0.78rem;
    color: var(--graphite);
    text-align: center;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--graphite);
    line-height: 1.5;
  }
</style>
