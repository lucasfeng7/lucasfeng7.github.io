---
import { Image } from 'astro:assets';
import { getImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** true = display against a panel (good for CAD/FEA renders on white) */
  panel?: boolean;
  /** widths hint for the Image srcset */
  wide?: boolean;
}

const { src, alt, caption, panel = false, wide = false } = Astro.props;
const img = getImage(src);
const cap = (n: number) => Math.min(n, img.width);
const widths = (wide ? [640, 960, 1280, 1600] : [480, 768, 1120]).map(cap);
const sizes = wide
  ? '(min-width: 1120px) 1080px, 100vw'
  : '(min-width: 800px) 720px, 100vw';
---

<figure class:list={['fig', { 'fig--panel': panel }]}>
  <Image src={img} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin-block: 1.75rem;
  }
  .fig :global(img) {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    margin-inline: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .fig--panel :global(img) {
    background: #fafafa;
    padding: clamp(0.5rem, 2vw, 1.25rem);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
