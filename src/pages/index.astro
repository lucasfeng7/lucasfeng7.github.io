---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectBlock from '../components/ProjectBlock.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout>
  <Hero />

  <section id="projects" class="section projects">
    <div class="wrap">
      <p class="eyebrow">Projects</p>
      <h2 class="projects__title">Selected work</h2>

      <div class="projects__list">
        {
          projects.map((p, i) => (
            <ProjectBlock
              href={`/projects/${p.id}`}
              title={p.data.title}
              metric={p.data.headlineMetric.value}
              tagline={p.data.tagline}
              image={p.data.heroImage}
              imageAlt={p.data.heroAlt}
              tags={p.data.tags}
              eager={i === 0}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects__title {
    margin-top: 0.4rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .projects__list {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 9vw, 6rem);
    min-width: 0;
  }
</style>
