---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../lib/site';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero section">
    <div class="wrap">
      <p class="eyebrow">{site.role}</p>
      <h1>{site.name}</h1>
      <p class="hero__lead">{site.tagline}</p>
      <div class="hero__cta">
        <a class="btn btn--accent" href="/projects">See the projects</a>
        <a class="btn" href={site.resumePath}>Résumé (PDF)</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="row">
        <p class="eyebrow">Featured work</p>
        <a href="/projects" class="row__all">All projects →</a>
      </div>
      <div class="grid">
        {
          featured.map((p) => (
            <ProjectCard
              href={`/projects/${p.id}`}
              title={p.data.title}
              metric={p.data.headlineMetric.value}
              tagline={p.data.tagline}
              image={p.data.heroImage}
              imageAlt={p.data.heroAlt}
              tags={p.data.tags}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact">
      <p class="eyebrow">Contact</p>
      <p class="contact__line">
        Looking for a Summer 2027 mechanical engineering internship.
      </p>
      <p class="contact__links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span aria-hidden="true">·</span>
        <a href={site.linkedin} target="_blank" rel="me noopener">{site.linkedinLabel}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 12vw, 7rem);
  }
  .hero h1 {
    margin-top: 0.5rem;
    font-size: clamp(2.4rem, 8vw, 4rem);
  }
  .hero__lead {
    margin-top: 1.25rem;
    max-width: 46ch;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    color: var(--text-muted);
  }
  .hero__cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .section--alt {
    background: var(--bg-subtle);
    border-block: 1px solid var(--border);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .row__all {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .row__all:hover {
    color: var(--accent);
  }
  .grid {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }
  .contact__line {
    margin-top: 0.5rem;
    font-size: clamp(1.15rem, 3vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }
  .contact__links {
    margin-top: 1rem;
    display: flex;
    gap: 0.75rem;
    color: var(--text-muted);
  }
  .contact__links a:hover {
    color: var(--accent);
  }
</style>
