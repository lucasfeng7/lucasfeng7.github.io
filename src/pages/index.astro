---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectBlock from '../components/ProjectBlock.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout>
  <Hero />

  <section id="projects" class="section">
    <div class="wrap">
      <h2 class="section-title">Projects</h2>
      <p class="section-intro">Research hardware I designed, built, and validated, each written up with its data.</p>

      <div class="projects">
        {
          projects.map((p, i) => (
            <ProjectBlock
              href={`/projects/${p.id}`}
              title={p.data.title}
              metric={p.data.headlineMetric.value}
              tagline={p.data.tagline}
              image={p.data.cardImage ?? p.data.heroImage}
              imageAlt={p.data.cardAlt ?? p.data.heroAlt}
              imagePosition={p.data.cardPosition}
              tags={p.data.tags}
              eager={i === 0}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="wrap about__grid">
      <div>
        <h2 class="section-title">About</h2>
        <div class="about__text">
          {site.about.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="skills">
        <h3>Skills</h3>
        {
          site.skills.map((s) => (
            <div class="skills__group">
              <h4>{s.group}</h4>
              <ul>
                {s.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="wrap">
      <h2 class="section-title">Get in touch</h2>
      <p class="section-intro">Email is the fastest way to reach me. My résumé has the full picture.</p>
      <div class="contact__actions">
        <a class="btn" href={`mailto:${site.email}`}><Icon name="mail" /> Email me</a>
        <a class="btn btn--secondary" href={site.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn</a>
        <a class="btn btn--secondary" href="/resume"><Icon name="file" /> Résumé</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  #projects,
  #about,
  #contact {
    scroll-margin-top: var(--nav-h);
  }
  #projects {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .projects {
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 6vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }

  .about {
    background: var(--surface);
  }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  .about__text {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.1rem;
    font-size: var(--text-lg);
    line-height: 1.6;
    max-width: 54ch;
  }
  .skills {
    align-self: start;
    background: var(--bg);
    border-radius: var(--r-media);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .skills h3 {
    font-size: var(--text-lg);
  }
  .skills__group {
    margin-top: 1.4rem;
  }
  .skills__group + .skills__group {
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .skills h4 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0;
  }
  .skills ul {
    margin-top: 0.5rem;
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .contact {
    text-align: center;
  }
  .contact .section-intro {
    margin-inline: auto;
  }
  .contact__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (max-width: 420px) {
    .contact__actions {
      flex-direction: column;
    }
  }
  @media (max-width: 820px) {
    .projects,
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
