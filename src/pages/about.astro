---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

const experience = [
  {
    org: 'JHU Neuroengineering & Biomedical Instrumentation Lab',
    role: 'Undergraduate Researcher — Tactile Sensing',
    dates: 'May 2026 – Present',
    points: [
      'Lead the mechanical development of two tactile-sensing systems, from CAD and nonlinear FEA through molding, fabrication, and hardware integration.',
      "Established the lab's calibration methodology for multi-axis force sensors — dead-weight loading with a regularized least-squares fit.",
      'Designed the sensor housing for a Velostat-based instrumented insole that captures plantar loading and joint kinematics for out-of-clinic recovery tracking after knee replacement, mentoring the high-school researchers who built it.',
    ],
  },
  {
    org: 'Johns Hopkins Baja SAE',
    role: 'Drivetrain Engineer',
    dates: 'Sep 2025 – Present',
    points: [
      'Diagnosed, disassembled, and rebuilt the drivetrain of a competition off-road vehicle with a five-person sub-team, restoring full transmission functionality under competition constraints.',
      'Designed and fabricated a custom photogate-based acceleration measurement system that enabled data-driven drivetrain tuning across varied terrain.',
    ],
  },
  {
    org: 'EriCAD',
    role: 'Co-Founder',
    dates: 'Oct 2025 – Jul 2026',
    points: [
      'Built an AI-powered GD&T automation platform that predicts manufacturing tolerances from part geometry, functional requirements, manufacturing capability, and cost constraints.',
      'Took it from concept to a working demonstration over a four-month build cycle; selected and funded by the Johns Hopkins Forge Incubator.',
    ],
  },
  {
    org: 'A-Level Capital',
    role: 'Associate',
    dates: 'Feb 2026 – Present',
    points: [
      'Student-run venture fund managing $5M AUM; source founders, run diligence on market and financials, and build the Excel models behind investment memos.',
    ],
  },
];

const skills = [
  ['CAD & simulation', 'SolidWorks · SolidWorks Simulation (nonlinear) · Fusion 360 · Onshape'],
  ['Manufacturing', 'CNC lathe / mill · welding · sand casting · sheet-metal forming · FDM & resin printing · silicone molding · laser cutting'],
  ['Programming', 'Python · C++ · Java'],
  ['Test & analysis', 'dead-weight calibration · regularized least squares · UR5e / RTDE · data pipelines'],
];

const coursework = [
  'Statics & Mechanics of Materials',
  'Mechanical Engineering Thermodynamics',
];
---

<BaseLayout title="About" description="Lucas Feng — mechanical engineering student at Johns Hopkins.">
  <section class="section">
    <div class="wrap about">
      <p class="eyebrow">About</p>
      <h1>{site.name}</h1>

      <div class="intro prose">
        <p>
          I'm a mechanical engineering student at Johns Hopkins (B.S. expected May 2029,
          GPA 3.88). I like problems that don't end at the CAD model — where you also have
          to build the thing, put it on a rig, and produce data that proves it works.
        </p>
        <p>
          Most of that work happens in the Neuroengineering &amp; Biomedical Instrumentation
          Lab, where I develop force and tactile sensors, and on Baja SAE, where I work on
          the drivetrain. I'm looking for a Summer 2027 mechanical engineering internship.
        </p>
      </div>

      <h2>Experience</h2>
      <ul class="xp">
        {
          experience.map((x) => (
            <li class="xp__item">
              <div class="xp__head">
                <span class="xp__org">{x.org}</span>
                <span class="xp__dates">{x.dates}</span>
              </div>
              <p class="xp__role">{x.role}</p>
              <ul class="xp__points">
                {x.points.map((p) => <li>{p}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>

      <div class="two">
        <div>
          <h2>Skills</h2>
          <dl class="skills">
            {
              skills.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div>
          <h2>Coursework</h2>
          <ul class="course">
            {coursework.map((c) => <li>{c}</li>)}
          </ul>
          <h2 style="margin-top:2rem;">Education</h2>
          <p class="edu">
            <strong>Johns Hopkins University</strong><br />
            Whiting School of Engineering<br />
            B.S. Mechanical Engineering, expected May 2029<br />
            GPA 3.88 / 4.0
          </p>
        </div>
      </div>

      <div class="contact">
        <a class="btn btn--accent" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn" href={site.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        <a class="btn" href={site.resumePath}>Résumé (PDF)</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about h1 {
    margin-top: 0.4rem;
    font-size: clamp(1.9rem, 6vw, 2.8rem);
  }
  .intro {
    margin-top: 1.5rem;
  }
  .about h2 {
    margin-top: 3rem;
    font-size: 1.3rem;
  }
  .xp {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: grid;
    gap: 1.75rem;
  }
  .xp__item {
    border-left: 2px solid var(--border-strong);
    padding-left: 1.1rem;
  }
  .xp__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .xp__org {
    font-weight: 600;
  }
  .xp__dates {
    color: var(--text-faint);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .xp__role {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-top: 0.1rem;
  }
  .xp__points {
    margin-top: 0.6rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.94rem;
  }
  .two {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .skills {
    margin-top: 1rem;
    display: grid;
    gap: 1rem;
  }
  .skills dt {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .skills dd {
    margin: 0.2rem 0 0;
    font-size: 0.94rem;
  }
  .course {
    margin-top: 1rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.94rem;
  }
  .edu {
    font-size: 0.94rem;
    line-height: 1.7;
  }
  .contact {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
