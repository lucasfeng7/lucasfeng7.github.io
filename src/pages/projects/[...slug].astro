---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContextStrip from '../../components/ContextStrip.astro';
import MetricBadge from '../../components/MetricBadge.astro';
import Figure from '../../components/Figure.astro';
import FigureRow from '../../components/FigureRow.astro';
import SpecTable from '../../components/SpecTable.astro';
import VideoFigure from '../../components/VideoFigure.astro';
import { getImage } from '../../lib/images';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const hero = getImage(data.heroImage);
const mdxComponents = { Figure, FigureRow, SpecTable, VideoFigure };
---

<BaseLayout title={data.title} description={data.tagline}>
  <article>
    <header class="phead">
      <div class="wrap">
        <a href="/#projects" class="back">← All projects</a>
        <h1>{data.title}</h1>
        <p class="lead">{data.tagline}</p>
        <MetricBadge value={data.headlineMetric.value} label={data.headlineMetric.label} />
      </div>
    </header>

    <div class="phero">
      <div class="wrap">
        <Image src={hero} alt={data.heroAlt} widths={[640, 1024, 1440, 1920]} sizes="(min-width: 1120px) 1080px, 100vw" loading="eager" fetchpriority="high" />
      </div>
    </div>

    <div class="wrap">
      <ContextStrip
        role={data.role}
        org={data.org}
        dateRange={data.dateRange}
        team={data.team}
        tools={data.tools}
        status={data.status}
      />

      <div class="prose">
        <Content components={mdxComponents} />
      </div>

      {
        data.links.length > 0 && (
          <div class="plinks">
            {data.links.map((l) => (
              <a class="btn" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                {l.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .phead {
    padding-top: 2.5rem;
  }
  .back {
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .back:hover {
    color: var(--accent);
  }
  .phead h1 {
    margin-top: 0.9rem;
    font-size: clamp(1.7rem, 5vw, 2.6rem);
  }
  .phead .lead {
    margin-top: 0.8rem;
    max-width: var(--prose-w);
  }
  .phead :global(.metric) {
    margin-top: 1.5rem;
  }
  .phero {
    margin-top: 2.5rem;
  }
  .phero :global(img) {
    display: block;
    max-width: 100%;
    max-height: 72vh;
    width: auto;
    height: auto;
    margin-inline: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #fafafa;
  }
  .plinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    max-width: var(--prose-w);
  }
</style>
