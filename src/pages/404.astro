---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 style="font-size: clamp(1.8rem, 6vw, 2.6rem); margin-top: 0.4rem;">Page not found</h1>
      <p class="lead" style="margin-top: 0.75rem;">That link doesn't lead anywhere.</p>
      <p style="margin-top: 1.5rem;"><a class="btn" href="/">Back home</a></p>
    </div>
  </section>
</BaseLayout>
