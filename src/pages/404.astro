---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <section class="section">
    <div class="wrap">
      <h1 style="font-size: var(--step-4); font-stretch: 125%;">Page not found</h1>
      <p class="lead" style="margin-top: 1rem;">This address doesn't match a page on the site. The home page lists every project.</p>
      <p style="margin-top: 1.5rem;"><a class="btn" href="/">Back home</a></p>
    </div>
  </section>
</BaseLayout>
