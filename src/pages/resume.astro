---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout title="Résumé" description="Lucas Feng — résumé.">
  <section class="section">
    <div class="wrap head">
      <h1>Résumé</h1>
      <p class="lead">{site.tagline}</p>
      <a class="btn" href={site.resumePath} download>Download PDF</a>
    </div>

    <div class="wrap">
      <iframe src={`${site.resumePath}#view=FitH`} title="Résumé PDF" class="viewer"></iframe>
      <p class="fallback">
        Not showing?
        <a href={site.resumePath} download>Download the résumé (PDF)</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .head h1 {
    font-size: var(--text-h1);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .head .lead {
    margin-top: 1.25rem;
    max-width: 52ch;
  }
  .head .btn {
    margin-top: 2rem;
  }
  .viewer {
    margin-top: 3rem;
    width: 100%;
    height: min(85vh, 1100px);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .fallback {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .fallback a {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
