---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout title="Résumé" description="Lucas Feng — résumé.">
  <section class="section">
    <div class="wrap head">
      <p class="eyebrow">Résumé</p>
      <h1>Résumé.</h1>
      <p class="lead">{site.tagline}</p>
      <a class="btn" href={site.resumePath} download>Download PDF</a>
    </div>

    <div class="wrap">
      <iframe src={`${site.resumePath}#view=FitH`} title="Résumé PDF" class="viewer"></iframe>
      <p class="fallback">
        Not showing?
        <a href={site.resumePath} download>Download the résumé (PDF)</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    text-align: center;
    max-width: 46rem;
  }
  .head h1 {
    margin-top: 0.5rem;
    font-size: clamp(3rem, 9vw, 5.5rem);
  }
  .head .lead {
    margin-top: 1.25rem;
    margin-inline: auto;
  }
  .head .btn {
    margin-top: 2rem;
  }
  .viewer {
    margin-top: 3rem;
    width: 100%;
    height: min(85vh, 1100px);
    border: 1px solid var(--border);
    background: var(--bg-subtle);
  }
  .fallback {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--text-faint);
  }
  .fallback a {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
